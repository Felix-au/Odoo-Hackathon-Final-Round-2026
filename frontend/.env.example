# API Gateway Base URLs
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_PORTAL_BASE_URL=http://localhost:3000/portal/v1

# Direct Service Fallback (when Gateway is not running)
VITE_AUTH_SERVICE_URL=http://localhost:3001
VITE_CATALOG_SERVICE_URL=http://localhost:3002

# Set to 'false' when connecting to live backend services
VITE_USE_MOCKS=true
