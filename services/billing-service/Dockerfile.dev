# Dockerfile.dev — Billing Service
FROM node:20-alpine

RUN apk add --no-cache openssl libc6-compat

WORKDIR /app

COPY package*.json ./
COPY src/db/prisma ./src/db/prisma/

RUN npm ci
RUN npx prisma generate --schema=src/db/prisma/schema.prisma

COPY . .

EXPOSE 3005

CMD ["sh", "-c", "npx prisma db push --schema=src/db/prisma/schema.prisma && npx tsx src/db/seed.ts && npm run dev"]
