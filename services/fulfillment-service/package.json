{
  "name": "fulfillment-service",
  "version": "1.0.0",
  "private": true,
  "description": "DealFlow360 Fulfillment Service — warehouse stock, split algorithm, backorder management",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate --schema=src/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=src/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=src/db/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=src/db/prisma/schema.prisma",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "prisma studio --schema=src/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@prisma/client": "^5.15.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^1.6.0",
    "prisma": "^5.15.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.6.0"
  }
}
