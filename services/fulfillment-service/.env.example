# Fulfillment Service — Environment Variables
NODE_ENV=development
PORT=3003

FULFILLMENT_DATABASE_URL=postgresql://dealflow:dealflow_dev@localhost:5435/fulfillment_db

REDIS_URL=redis://localhost:6379

# Must match auth-service JWT_SECRET (min 32 chars)
JWT_SECRET=your-jwt-secret-here-minimum-32-characters

# Internal service-to-service auth token (min 16 chars)
SERVICE_TOKEN=your-service-token-here

LOG_LEVEL=info
