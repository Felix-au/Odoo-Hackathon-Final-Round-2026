# ─────────────────────────────────────────────────────────────
# Auth Service — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# ─── Database ─────────────────────────────────────────────────
AUTH_DATABASE_URL=postgresql://dealflow:dealflow_dev@localhost:5432/auth_db

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────
# Must be at least 32 chars; use 64+ in production
JWT_SECRET=dev_jwt_secret_change_in_prod_must_be_64_chars_minimum_dev_only_x
JWT_ACCESS_EXPIRY=28800
JWT_REFRESH_EXPIRY=2592000

# ─── Magic Link / Portal Sessions ─────────────────────────────
MAGIC_LINK_TTL_SECONDS=86400
PORTAL_SESSION_TTL_SECONDS=604800
APP_BASE_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3000/portal

# ─── Email (Mailpit SMTP for local dev) ───────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@dealflow360.dev

# ─── Service-to-Service Token ─────────────────────────────────
SERVICE_TOKEN=dev_service_token_for_internal_calls_min_16

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
