# Dockerfile.dev — Auth Service (hot reload for development)
FROM node:20-alpine
RUN apk add --no-cache openssl

WORKDIR /app

# Install dependencies first (better layer caching)
COPY package*.json ./

RUN npm ci

COPY . .

# Generate Prisma client (schema is at src/db/prisma/schema.prisma)
RUN npx prisma generate --schema=src/db/prisma/schema.prisma

EXPOSE 3001

# Run migrations + seed + start with tsx watch (hot reload)
CMD ["sh", "-c", "npx prisma db push --schema=src/db/prisma/schema.prisma --accept-data-loss && npx tsx src/db/seed.ts && npm run dev"]
