# Dockerfile.dev — Auth Service (hot reload for development)
FROM node:20-alpine
RUN apk add --no-cache openssl

WORKDIR /app

# Install dependencies first (better layer caching)
COPY package*.json ./
COPY prisma ./prisma/

RUN npm ci

# Generate Prisma client
RUN npx prisma generate

COPY . .

EXPOSE 3001

# Run migrations + seed + start with tsx watch (hot reload)
CMD ["sh", "-c", "npx prisma migrate deploy && npx tsx src/db/seed.ts && npm run dev"]
