# ─────────────────────────────────────────────────────────────
# Catalog Service — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3002

# ─── Database ─────────────────────────────────────────────────
CATALOG_DATABASE_URL=postgresql://dealflow:dealflow_dev@localhost:5433/catalog_db

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (shared secret with Auth Service) ────────────────────
JWT_SECRET=dev_jwt_secret_change_in_prod_must_be_64_chars_minimum_dev_only_x

# ─── Service-to-Service Token ─────────────────────────────────
SERVICE_TOKEN=dev_service_token_for_internal_calls_min_16

# ─── Cache TTLs (seconds) ─────────────────────────────────────
CATALOG_CACHE_TTL_SECONDS=300
DISCOUNT_CEILING_CACHE_TTL=300
APPROVAL_CHAIN_CACHE_TTL=900

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
