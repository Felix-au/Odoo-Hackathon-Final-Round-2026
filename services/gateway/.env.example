# Gateway Service Environment Variables
# Copy this to .env and fill in values for local development outside Docker

NODE_ENV=development
PORT=3000

# Upstream service URLs (use localhost ports when running services locally)
AUTH_SERVICE_URL=http://localhost:3001
CATALOG_SERVICE_URL=http://localhost:3002
QUOTATION_SERVICE_URL=http://localhost:3003
FULFILLMENT_SERVICE_URL=http://localhost:3004
BILLING_SERVICE_URL=http://localhost:3005
ANALYTICS_SERVICE_URL=http://localhost:3006

# JWT (must match all services)
JWT_SECRET=dev_jwt_secret_change_in_prod_must_be_64_chars_minimum_dev_only_x

# Redis (for portal session lookup)
REDIS_URL=redis://localhost:6379

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173
