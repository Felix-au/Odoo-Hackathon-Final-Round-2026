// analytics-service/src/db/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("ANALYTICS_DATABASE_URL")
}

// ─────────────────────────────────────────────
// Quotation snapshots (replicated from events)
// ─────────────────────────────────────────────

model QuotationSnapshot {
  id               String   @id // quotationId from quotation_db
  companyId        String   @default("default")
  repId            String
  repName          String
  customerId       String
  customerName     String
  customerTier     String   @default("STANDARD")
  status           String
  totalAmount      Decimal  @db.Decimal(12, 4)
  totalMarginPct   Float    @default(0)
  blendedRiskScore Float    @default(0)
  currency         String   @default("USD")
  lastActivityAt   DateTime @default(now())
  createdAt        DateTime @default(now())
  confirmedAt      DateTime?
  updatedAt        DateTime @updatedAt

  lines            QuotationLineSnapshot[]

  @@index([companyId, status])
  @@index([companyId, repId])
  @@index([lastActivityAt])
}

model QuotationLineSnapshot {
  id            String  @id @default(uuid())
  quotationId   String
  companyId     String  @default("default")
  productId     String
  productName   String
  categoryId    String?
  categoryName  String?
  discountPct   Float   @default(0)
  lineTotal     Decimal @db.Decimal(12, 4)
  marginPct     Float   @default(0)

  quotation     QuotationSnapshot @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([companyId, productId])
}

// ─────────────────────────────────────────────
// Deal Health Config
// ─────────────────────────────────────────────

model DealHealthConfig {
  id                   String   @id @default(uuid())
  companyId            String   @unique @default("default")
  stallDaysThreshold   Int      @default(7) // days of inactivity = stalled
  anomalyStdDevFactor  Float    @default(2.0) // discount > repAvg + (factor * stdDev) = anomaly
  deliverySlippageDays Int      @default(3) // days past expected ship date = slippage alert
  updatedAt            DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Deal Health Alerts
// ─────────────────────────────────────────────

model DealAlert {
  id          String    @id @default(uuid())
  companyId   String    @default("default")
  quotationId String
  type        String    // STALLED | DISCOUNT_ANOMALY | DELIVERY_SLIPPAGE
  severity    String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  message     String
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  nudges      NudgeAction[]

  @@index([companyId, isResolved])
  @@index([quotationId])
}

model NudgeAction {
  id          String   @id @default(uuid())
  alertId     String
  quotationId String
  triggeredBy String   // userId
  type        String   // EMAIL_NUDGE | ESCALATION
  sentTo      String[] // email addresses or user IDs
  createdAt   DateTime @default(now())

  alert       DealAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
}

// ─────────────────────────────────────────────
// Billing Snapshots
// ─────────────────────────────────────────────

model InvoiceSnapshot {
  id        String    @id // invoiceId
  companyId String    @default("default")
  orderId   String
  customerId String
  type      String
  status    String
  amount    Decimal   @db.Decimal(12, 4)
  currency  String    @default("USD")
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId, type])
  @@index([companyId, status])
}

model SubscriptionSnapshot {
  id              String   @id
  companyId       String   @default("default")
  orderId         String
  customerId      String
  planName        String
  interval        String   // MONTHLY | QUARTERLY | YEARLY
  quantity        Int      @default(1)
  unitPrice       Decimal  @db.Decimal(12, 4)
  status          String   // ACTIVE | CANCELLED
  nextBillingDate DateTime

  @@index([companyId, status])
  @@index([nextBillingDate])
}
