# Dockerfile.dev — Quotation Service
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
COPY src/db/prisma ./src/db/prisma/

RUN npm ci
RUN npx prisma generate --schema=src/db/prisma/schema.prisma

COPY . .

EXPOSE 3003

CMD ["sh", "-c", "npx prisma migrate deploy --schema=src/db/prisma/schema.prisma && npx tsx src/db/seed.ts && npm run dev"]
