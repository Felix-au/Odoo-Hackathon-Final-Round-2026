# DealFlow360 Quotation Service env vars
NODE_ENV=development
LOG_LEVEL=info
PORT=3003

# Database
QUOTATION_DATABASE_URL=postgresql://quot_user:quot_pass@localhost:5432/quotation_db

# Redis (cache + streams)
REDIS_URL=redis://localhost:6379

# Auth (JWT verification)
JWT_SECRET=change-me

# Downstream services
CATALOG_SERVICE_URL=http://catalog-service:3002
FULFILLMENT_SERVICE_URL=http://fulfillment-service:3004

# Service-to-service secret
SERVICE_SECRET=change-me-shared-secret

# Email (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@dealflow360.local