# ─────────────────────────────────────────────────────────────
# DealFlow360 — Environment Variables
# Copy this file to .env and fill in values.
# .env is gitignored — never commit secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ─── PostgreSQL databases (separate DB per service) ──────────
AUTH_DATABASE_URL=postgresql://dealflow:dealflow_dev@localhost:5432/auth_db
CATALOG_DATABASE_URL=postgresql://dealflow:dealflow_dev@localhost:5433/catalog_db
QUOTATION_DATABASE_URL=postgresql://dealflow:dealflow_dev@localhost:5434/quotation_db
FULFILLMENT_DATABASE_URL=postgresql://dealflow:dealflow_dev@localhost:5435/fulfillment_db
BILLING_DATABASE_URL=postgresql://dealflow:dealflow_dev@localhost:5436/billing_db
ANALYTICS_DATABASE_URL=postgresql://dealflow:dealflow_dev@localhost:5437/analytics_db

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication ──────────────────────────────────────────
# MUST be at least 64 chars in production
JWT_SECRET=dev_jwt_secret_change_in_prod_must_be_64_chars_minimum_dev_only_x
JWT_ACCESS_EXPIRY=28800
JWT_REFRESH_EXPIRY=2592000
MAGIC_LINK_TTL_SECONDS=86400
PORTAL_SESSION_TTL_SECONDS=604800

# ─── Email ───────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@dealflow360.dev

# ─── App URLs ────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3000/portal

# ─── Service-to-Service ──────────────────────────────────────
SERVICE_TOKEN=dev_service_token_for_internal_calls_min_16

# ─── Service URLs (used by gateway + inter-service calls) ────
AUTH_SERVICE_URL=http://localhost:3001
CATALOG_SERVICE_URL=http://localhost:3002
QUOTATION_SERVICE_URL=http://localhost:3003
FULFILLMENT_SERVICE_URL=http://localhost:3004
BILLING_SERVICE_URL=http://localhost:3005
ANALYTICS_SERVICE_URL=http://localhost:3006

# ─── Frontend ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_PORTAL_BASE_URL=http://localhost:3000/portal/v1

# ─── PDF Export ──────────────────────────────────────────────
EXPORT_PUPPETEER_EXECUTABLE=/usr/bin/chromium-browser
